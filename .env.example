# Template only. Create a local .env with random secrets:
#   PowerShell: .\scripts\init-env.ps1      POSIX: ./scripts/init-env.sh
# PostgreSQL roles are created once, on an empty data volume; changing these later needs a volume reset.

POSTGRES_PASSWORD=change-me
EXECUTION_DB_OWNER_PASSWORD=change-me
EXECUTION_DB_APP_PASSWORD=change-me
MARKET_DATA_DB_OWNER_PASSWORD=change-me
MARKET_DATA_DB_APP_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Demo logins: users 'operator' and 'trader'.
DEV_OPERATOR_PASSWORD=change-me
DEV_TRADER_PASSWORD=change-me

# Market Data's token for Execution's internal trade export. Without it, the export refuses every request.
MSE_EXPORT_TOKEN=change-me

# The simulator's control credential for its assignment and heartbeat. It can't trade.
MSE_SIMULATOR_TOKEN=change-me

# With the full profile, set up a demo market on first start: five instruments, the trader funded, bots
# provisioned, the market open. Leaves a market that is already open alone. The bots are a fifth market
# makers and a fifth momentum, the rest noise, with at least one market maker.
MSE_DEMO_SEED=true
MSE_DEMO_BOTS=20

# Host ports, all bound to 127.0.0.1. If one is taken on this machine, change it here.
WEB_HOST_PORT=8080
POSTGRES_HOST_PORT=15432
KAFKA_HOST_PORT=19092
FLINK_UI_HOST_PORT=18081
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
