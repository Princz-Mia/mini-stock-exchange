{
  "type": "record",
  "name": "MarketSnapshot",
  "namespace": "com.mia_princz.mse.contracts.events",
  "doc": "Complete public state of one instrument after a command, on compacted topic mse.market.v1. A newer snapshot replaces an older one entirely. Contains no order ids, owners or private lifecycle data.",
  "fields": [
    {"name": "eventId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "simulationId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "instrumentId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "symbol", "type": "string"},
    {"name": "venueState", "type": {
      "type": "enum", "name": "VenueState", "symbols": ["SETUP", "OPEN", "HALTED", "UNKNOWN"], "default": "UNKNOWN",
      "doc": "UNKNOWN is what an older reader sees for a state added later."
    }},
    {"name": "rules", "type": {
      "type": "record", "name": "MarketRules",
      "fields": [
        {"name": "ruleVersion", "type": "int"},
        {"name": "referencePriceCents", "type": "long", "doc": "Shown before the first trade; never executable liquidity."},
        {"name": "tickCents", "type": "long"},
        {"name": "lotSize", "type": "long"},
        {"name": "minQuantity", "type": "long"},
        {"name": "maxQuantity", "type": "long"},
        {"name": "maxPriceCents", "type": "long"},
        {"name": "maxOpenOrdersPerAccount", "type": "int"},
        {"name": "maxFillsPerCommand", "type": "int"}
      ]
    }},
    {"name": "bids", "doc": "Best first, at most 20 levels.", "type": {"type": "array", "items": {
      "type": "record", "name": "BookLevel",
      "fields": [
        {"name": "priceCents", "type": "long"},
        {"name": "quantity", "type": "long"},
        {"name": "orderCount", "type": "int"}
      ]
    }}},
    {"name": "asks", "doc": "Best first, at most 20 levels.", "type": {"type": "array", "items": "BookLevel"}},
    {"name": "recentTrades", "doc": "Newest first, at most 50.", "type": {"type": "array", "items": {
      "type": "record", "name": "PublicTrade",
      "fields": [
        {"name": "tradeId", "type": {"type": "string", "logicalType": "uuid"}},
        {"name": "tradeSequence", "type": "long"},
        {"name": "priceCents", "type": "long"},
        {"name": "quantity", "type": "long"},
        {"name": "aggressorSide", "type": {
          "type": "enum", "name": "AggressorSide", "symbols": ["BUY", "SELL"],
          "doc": "The side of the incoming order that took liquidity."
        }},
        {"name": "executedAt", "type": {"type": "long", "logicalType": "timestamp-micros"}}
      ]
    }}},
    {"name": "lastTrade", "type": ["null", "PublicTrade"], "default": null, "doc": "Null before the first trade."},
    {"name": "lastTradeSequence", "type": "long", "doc": "0 before the first trade."},
    {"name": "sourceCommandSequence", "type": "long", "doc": "The command this state follows; a higher value replaces a lower one."},
    {"name": "generatedAt", "type": {"type": "long", "logicalType": "timestamp-micros"}}
  ]
}
